{
  "goal": "opening_to_viridian",
  "comment": "HAND-SEEDED spine-validation plan (SPD step 1). Verified op-by-op manually 2026-08-10. Not record-run material: the record run requires a model-authored plan (CLAIM_RULES v1).",
  "subgoals": [
    {
      "id": "leave_house",
      "macro": [
        {"op": "use_warp", "x": 7, "y": 1, "when": {"map": "REDS_HOUSE_2F"}},
        {"op": "use_warp", "x": 2, "y": 7, "when": {"map": "REDS_HOUSE_1F"}}
      ],
      "done_when": {"map": "PALLET_TOWN", "mode": "overworld"}
    },
    {
      "id": "get_starter",
      "macro": [
        {"op": "cross", "dir": "north", "when": {"map": "PALLET_TOWN"}},
        {"op": "wait", "frames": 30},
        {"op": "interact", "name": "OAKSLAB_SQUIRTLE_POKE_BALL", "when": {"map": "OAKS_LAB", "mode": "overworld"}},
        {"op": "menu", "index": 1, "when": {"mode": "ui"}},
        {"op": "menu", "index": 2, "when": {"mode": "ui"}}
      ],
      "done_when": {"party_nonempty": true},
      "max_attempts": 4
    },
    {
      "id": "win_rival",
      "macro": [
        {"op": "menu", "index": 2, "when": {"mode": "ui"}},
        {"op": "use_warp", "x": 4, "y": 11, "when": {"map": "OAKS_LAB", "mode": "overworld"}}
      ],
      "battle_policy": "default",
      "done_when": {"flag": "EVENT_BATTLED_RIVAL_IN_OAKS_LAB", "no_battle": true},
      "max_attempts": 4
    },
    {
      "id": "exit_lab",
      "macro": [
        {"op": "use_warp", "x": 4, "y": 11, "when": {"map": "OAKS_LAB", "mode": "overworld"}}
      ],
      "done_when": {"map": "PALLET_TOWN", "mode": "overworld"}
    },
    {
      "id": "to_route1",
      "macro": [
        {"op": "cross", "dir": "north", "when": {"map": "PALLET_TOWN"}}
      ],
      "battle_policy": "default",
      "done_when": {"map": "ROUTE_1", "mode": "overworld"}
    },
    {
      "id": "to_viridian",
      "macro": [
        {"op": "cross", "dir": "north", "when": {"map": "ROUTE_1"}}
      ],
      "battle_policy": "default",
      "done_when": {"map": "VIRIDIAN_CITY", "mode": "overworld"},
      "max_attempts": 5
    },
    {
      "id": "get_parcel",
      "macro": [
        {"op": "use_warp", "x": 29, "y": 19, "when": {"map": "VIRIDIAN_CITY"}},
        {"op": "interact", "name": "VIRIDIANMART_CLERK", "when": {"map": "VIRIDIAN_MART"}}
      ],
      "done_when": {"flag": "EVENT_GOT_OAKS_PARCEL"},
      "max_attempts": 4
    },
    {
      "id": "exit_mart",
      "macro": [
        {"op": "use_warp", "x": 3, "y": 7, "when": {"map": "VIRIDIAN_MART"}}
      ],
      "done_when": {"map": "VIRIDIAN_CITY", "mode": "overworld"}
    },
    {
      "id": "back_to_route1",
      "macro": [
        {"op": "cross", "dir": "south", "when": {"map": "VIRIDIAN_CITY"}}
      ],
      "battle_policy": "default",
      "done_when": {"map": "ROUTE_1", "mode": "overworld"}
    },
    {
      "id": "back_to_pallet",
      "macro": [
        {"op": "cross", "dir": "south", "when": {"map": "ROUTE_1"}}
      ],
      "battle_policy": "default",
      "done_when": {"map": "PALLET_TOWN", "mode": "overworld"},
      "max_attempts": 5
    },
    {
      "id": "deliver_parcel",
      "macro": [
        {"op": "use_warp", "x": 12, "y": 11, "when": {"map": "PALLET_TOWN"}},
        {"op": "interact", "name": "OAKSLAB_OAK1", "when": {"map": "OAKS_LAB"}}
      ],
      "done_when": {"flag": "EVENT_GOT_POKEDEX"},
      "max_attempts": 4
    },
    {
      "id": "exit_lab_2",
      "macro": [
        {"op": "use_warp", "x": 4, "y": 11, "when": {"map": "OAKS_LAB", "mode": "overworld"}}
      ],
      "done_when": {"map": "PALLET_TOWN", "mode": "overworld"}
    },
    {
      "id": "north_again_route1",
      "macro": [
        {"op": "cross", "dir": "north", "when": {"map": "PALLET_TOWN"}}
      ],
      "battle_policy": "default",
      "done_when": {"map": "ROUTE_1", "mode": "overworld"}
    },
    {
      "id": "north_again_viridian",
      "macro": [
        {"op": "cross", "dir": "north", "when": {"map": "ROUTE_1"}}
      ],
      "battle_policy": "default",
      "done_when": {"map": "VIRIDIAN_CITY", "mode": "overworld"},
      "max_attempts": 5
    },
    {
      "id": "to_route2",
      "macro": [
        {"op": "interact", "name": "VIRIDIANCITY_OLD_MAN_SLEEPY", "when": {"map": "VIRIDIAN_CITY"}},
        {"op": "cross", "dir": "north", "when": {"map": "VIRIDIAN_CITY"}}
      ],
      "battle_policy": "default",
      "done_when": {"map": "ROUTE_2", "mode": "overworld"},
      "max_attempts": 5
    }
  ]
}
